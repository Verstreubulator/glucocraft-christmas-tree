# Copy to secrets.yaml (never commit it) and fill in your own values.
wifi_ssid: "your-network-name"
wifi_password: "your-network-password"
# 32 random bytes, base64: for example `openssl rand -base64 32`
tree_api_encryption_key: "replace-with-a-base64-key-of-32-bytes============"
tree_fallback_ap_password: "replace-with-a-password"
